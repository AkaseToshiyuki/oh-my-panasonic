diff --git a/crates/facelock-face/src/native.rs b/crates/facelock-face/src/native.rs
new file mode 100644
index 0000000..97d9bdb
--- /dev/null
+++ b/crates/facelock-face/src/native.rs
@@ -0,0 +1,73 @@
+use facelock_core::{FacelockError, Result};
+use std::{
+    ffi::{CString, c_char, c_int, c_void},
+    os::unix::ffi::OsStrExt,
+    path::Path,
+    ptr::NonNull,
+};
+#[link(name = "pou_ov")]
+unsafe extern "C" {
+    fn pou_ov_create(path: *const c_char, side: c_int) -> *mut c_void;
+    fn pou_ov_destroy(network: *mut c_void);
+    fn pou_ov_run(network: *mut c_void, input: *const f32, len: usize) -> c_int;
+    fn pou_ov_output(network: *mut c_void, index: usize, len: *mut usize) -> *const f32;
+}
+pub(crate) struct Network {
+    handle: NonNull<c_void>,
+    side: u32,
+}
+// Inference requires &mut self. A network can move to the auth engine's sole owner.
+unsafe impl Send for Network {}
+impl Network {
+    pub(crate) fn load(path: &Path, side: u32, provider: &str) -> Result<Self> {
+        if provider != "openvino" && provider != "cpu" {
+            return Err(FacelockError::Detection(
+                "Dedicated GPU backend expects OpenVINO".into(),
+            ));
+        }
+        let name = CString::new(path.as_os_str().as_bytes())
+            .map_err(|_| FacelockError::Detection("Invalid model path".into()))?;
+        let handle = NonNull::new(unsafe { pou_ov_create(name.as_ptr(), side as c_int) })
+            .ok_or_else(|| FacelockError::Detection("OpenVINO GPU load failed".into()))?;
+        Ok(Self { handle, side })
+    }
+    pub(crate) fn run(&mut self, input: &[f32]) -> Result<Vec<Vec<f32>>> {
+        let count = unsafe { pou_ov_run(self.handle.as_ptr(), input.as_ptr(), input.len()) };
+        let expected = if self.side == 112 {
+            vec![512]
+        } else {
+            [1, 4, 10]
+                .into_iter()
+                .flat_map(|attributes| {
+                    [8, 16, 32]
+                        .map(|stride| ((640 / stride) * (640 / stride) * 2 * attributes) as usize)
+                })
+                .collect()
+        };
+        if count != expected.len() as i32 {
+            return Err(FacelockError::Detection("OpenVINO output count".into()));
+        }
+        let mut result = Vec::with_capacity(expected.len());
+        for (i, size) in expected.into_iter().enumerate() {
+            let mut len = 0;
+            let ptr = unsafe { pou_ov_output(self.handle.as_ptr(), i, &mut len) };
+            if ptr.is_null() || len != size {
+                return Err(FacelockError::Detection(format!(
+                    "OpenVINO output {i} size {len}, expected {size}"
+                )));
+            }
+            // Owned copy before the next inference can reuse the request's buffer.
+            let values = unsafe { std::slice::from_raw_parts(ptr, len) };
+            if !values.iter().all(|v| v.is_finite()) {
+                return Err(FacelockError::Detection("Invalid OpenVINO output".into()));
+            }
+            result.push(values.to_vec());
+        }
+        Ok(result)
+    }
+}
+impl Drop for Network {
+    fn drop(&mut self) {
+        unsafe { pou_ov_destroy(self.handle.as_ptr()) }
+    }
+}
