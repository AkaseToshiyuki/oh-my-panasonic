new file mode 100644
index 0000000..b136709
--- /dev/null
+++ b/crates/facelock-cli/src/commands/auth/startup.rs
@@ -0,0 +1,102 @@
+use facelock_core::types::{FaceEmbedding, zeroize_stored_embeddings};
+
+/// Own the decrypted set through startup, including cancellation and unwinding.
+pub(super) struct Templates<T: AsMut<[(u32, FaceEmbedding)]>>(T);
+
+impl<T: AsMut<[(u32, FaceEmbedding)]>> Templates<T> {
+    pub(super) fn new(rows: T) -> Self { Self(rows) }
+    pub(super) fn as_mut_slice(&mut self) -> &mut [(u32, FaceEmbedding)] { self.0.as_mut() }
+}
+
+impl<T: AsMut<[(u32, FaceEmbedding)]>> Drop for Templates<T> {
+    fn drop(&mut self) { zeroize_stored_embeddings(self.0.as_mut()); }
+}
+
+/// Always join the per-attempt reader, even when foreground startup fails.
+pub(super) fn parallel<T: Send, R>(
+    load_templates: impl FnOnce() -> T + Send,
+    foreground: impl FnOnce() -> R,
+) -> (R, std::thread::Result<T>) {
+    std::thread::scope(|scope| {
+        let reader = scope.spawn(load_templates);
+        let result = foreground();
+        (result, reader.join())
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Barrier, atomic::{AtomicBool, Ordering}};
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+
+    #[test]
+    fn resources_and_templates_make_progress_together() {
+        let barrier = Arc::new(Barrier::new(2));
+        let reader_barrier = barrier.clone();
+        let (result, rows) = parallel(move || { reader_barrier.wait(); 42 }, || { barrier.wait(); 7 });
+        assert_eq!(result, 7);
+        assert_eq!(rows.unwrap(), 42);
+    }
+
+    #[test]
+    fn early_resource_failure_still_joins_and_wipes_templates() {
+        let mut rows = vec![(1, [0.75; 512])];
+        let finished = AtomicBool::new(false);
+        let (result, templates) = parallel(
+            || { finished.store(true, Ordering::SeqCst); Templates::new(rows.as_mut_slice()) },
+            || Err::<(), _>("camera unavailable"),
+        );
+        assert_eq!(result, Err("camera unavailable"));
+        assert!(finished.load(Ordering::SeqCst));
+        drop(templates);
+        assert!(rows[0].1.iter().all(|x| *x == 0.0));
+    }
+
+    #[test]
+    fn foreground_panic_joins_and_wipes_unclaimed_result() {
+        let mut rows = vec![(1, [0.75; 512])];
+        let barrier = Barrier::new(2);
+        let result = catch_unwind(AssertUnwindSafe(|| {
+            parallel(|| { let protected = Templates::new(rows.as_mut_slice()); barrier.wait(); protected },
+                     || -> () { barrier.wait(); panic!("startup failed") });
+        }));
+        assert!(result.is_err());
+        assert!(rows[0].1.iter().all(|x| *x == 0.0));
+    }
+
+    #[test]
+    fn reader_error_is_preserved() {
+        let (resource, rows) = parallel(|| Err::<(), _>("TPM unavailable"), || 7);
+        assert_eq!(resource, 7);
+        assert_eq!(rows.unwrap(), Err("TPM unavailable"));
+    }
+
+    #[test]
+    fn reader_panic_is_an_error_and_wipes_owned_rows() {
+        let mut rows = vec![(1, [0.75; 512])];
+        let (_, result) = parallel(|| { let _protected = Templates::new(rows.as_mut_slice()); panic!("reader failed") }, || ());
+        assert!(result.is_err());
+        assert!(rows[0].1.iter().all(|x| *x == 0.0));
+    }
+
+    #[test]
+    fn cancellation_drops_pending_templates_without_comparing() {
+        let mut rows = vec![(1, [0.75; 512])];
+        let (cancelled, result) = parallel(|| Templates::new(rows.as_mut_slice()), || true);
+        assert!(cancelled);
+        drop(result);
+        assert!(rows[0].1.iter().all(|x| *x == 0.0));
+    }
+
+    #[test]
+    fn successful_handoff_preserves_values_until_finished() {
+        let mut rows = vec![(1, [0.75; 512])];
+        {
+            let (_, templates) = parallel(|| Templates::new(rows.as_mut_slice()), || ());
+            let mut templates = templates.unwrap();
+            assert_eq!(templates.as_mut_slice()[0].1[0], 0.75);
+        }
+        assert!(rows[0].1.iter().all(|x| *x == 0.0));
+    }
+}
diff --git a/crates/facelock-cli/src/commands/auth/timing.rs b/crates/facelock-cli/src/commands/auth/timing.rs
new file mode 100644
index 0000000..7decf98
--- /dev/null
+++ b/crates/facelock-cli/src/commands/auth/timing.rs
@@ -0,0 +1,38 @@
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+#[derive(Clone, Copy)]
+pub enum Phase { Preflight, Models, Camera, Templates, Warmup, Recognition }
+
+pub struct Timings {
+    started: Instant,
+    micros: [AtomicU64; 6],
+}
+
+impl Timings {
+    pub fn new() -> Self {
+        Self { started: Instant::now(), micros: std::array::from_fn(|_| AtomicU64::new(0)) }
+    }
+    pub fn preflight_complete(&self) {
+        self.micros[Phase::Preflight as usize].store(self.started.elapsed().as_micros() as u64, Ordering::Relaxed);
+    }
+    pub fn guard(&self, phase: Phase) -> Measurement<'_> {
+        Measurement { started: Instant::now(), output: &self.micros[phase as usize] }
+    }
+    pub fn measure<T>(&self, phase: Phase, call: impl FnOnce() -> T) -> T {
+        let _measurement = self.guard(phase);
+        call()
+    }
+}
+
+impl Drop for Timings {
+    fn drop(&mut self) {
+        let ms = self.micros.each_ref().map(|v| v.load(Ordering::Relaxed) as f64 / 1000.0);
+        eprintln!("OMP_FACE_TIMING preflight_ms={:.3} models_ms={:.3} camera_ms={:.3} templates_ms={:.3} warmup_ms={:.3} recognition_ms={:.3} total_ms={:.3}", ms[0], ms[1], ms[2], ms[3], ms[4], ms[5], self.started.elapsed().as_secs_f64()*1000.0);
+    }
+}
+
+pub struct Measurement<'a> { started: Instant, output: &'a AtomicU64 }
+impl Drop for Measurement<'_> {
+    fn drop(&mut self) { self.output.fetch_add(self.started.elapsed().as_micros() as u64, Ordering::Relaxed); }
+}
