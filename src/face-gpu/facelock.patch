+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if unsafe { libc::geteuid() } != 0 || args.len() != 3 || args[0] != "auth" || args[1] != "-u" {
+        std::process::exit(2);
+    }
+    let code = facelock_cli::commands::auth::run(args[2].clone(), None, 0);
+    std::process::exit(code);
+}
