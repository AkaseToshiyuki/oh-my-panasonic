#!/usr/bin/python3 -I
from pathlib import Path
import sys
from evdev import InputDevice
from panasonic_on_ubuntu.touchpad import validate
try:
    d = InputDevice('/dev/input/pou-touchpad')
    try:
        validate(d)
    finally:
        d.close()
except Exception as exc:
    print(f'POU device check failed: {exc}', file=sys.stderr)
    sys.exit(1)
