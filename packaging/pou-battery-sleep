#!/bin/sh
state=/run/panasonic-on-ubuntu/battery-resume
case "$1" in
    pre)
        rm -f -- "$state"
        if systemctl is-active --quiet pou-battery.service; then
            install -m 600 /dev/null "$state"
            timeout 15s systemctl stop pou-battery.service
            if [ "$2" = suspend ]; then
                /usr/bin/python3 -I -m panasonic_on_ubuntu.care arm-suspend
            fi
        fi
        ;;
    post)
        if [ -f "$state" ]; then
            rm -f -- "$state"
            timeout 15s systemctl start pou-battery.service
        fi
        ;;
esac
