[Unit]
Description=Oh My Panasonic CPU measurement and guarded power presets
# The daemon announces readiness before applying presets. Ubuntu orders
# power-profiles-daemon after multi-user.target and activates it over D-Bus.
After=dbus.service systemd-modules-load.service pou-firmware-restore.service pou-boot-power-init.service

[Service]
Type=notify
ExecStart=/usr/bin/python3 -I -m panasonic_on_ubuntu.power
ExecStopPost=/usr/bin/python3 -I -m panasonic_on_ubuntu.power restore
Restart=on-failure
RestartSec=5
WatchdogSec=15
TimeoutStopSec=15
KillMode=control-group
UMask=0022
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
